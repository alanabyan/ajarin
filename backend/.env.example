# Ganti dengan connection string dari Supabase atau Neon (keduanya PostgreSQL)
# Supabase: Project Settings > Database > Connection string (mode "Transaction" atau "Session")
# Neon: Dashboard project > Connection Details
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Ganti dengan string acak yang panjang, jangan pakai nilai contoh ini di produksi
JWT_SECRET="ganti-dengan-string-acak-yang-panjang"
JWT_EXPIRES_IN="7d"

PORT=4000
CLIENT_URL="http://localhost:5173"

# API key Claude untuk fitur generate modul ajar dan bank soal
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"
