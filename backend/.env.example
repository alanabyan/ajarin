# PostgreSQL (Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/pelita_guru?sslmode=require"
JWT_SECRET="ganti-dengan-string-acak-panjang"

# AI (Groq)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Batas pembuatan dokumen AI per akun per hari
AI_DAILY_LIMIT=20

# Origin frontend produksi (pisahkan koma bila lebih dari satu)
CLIENT_URL="http://localhost:5173"
PORT=4000
