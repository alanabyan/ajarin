# PostgreSQL (Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/pelita_guru?sslmode=require"
JWT_SECRET="ganti-dengan-string-acak-panjang"

# AI (Groq)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Batas pembuatan dokumen AI per akun per hari
AI_DAILY_LIMIT=20

# Origin frontend produksi (pisahkan koma bila lebih dari satu)
CLIENT_URL="http://localhost:5173"
PORT=4000

# Email verifikasi akun (Gmail SMTP). Buat App Password di akun Google (wajib verifikasi 2 langkah):
# https://myaccount.google.com/apppasswords  -> isi SMTP_USER dengan alamat Gmail, SMTP_PASS dengan app password.
# Tanpa SMTP di mode pengembangan, tautan verifikasi dicetak di konsol server.
SMTP_USER=""
SMTP_PASS=""
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# MAIL_FROM="Ajarin <alamat@gmail.com>"
# Alamat frontend untuk tautan di email (bawaan: origin pertama di CLIENT_URL)
# APP_URL="https://ajarin.vercel.app"
